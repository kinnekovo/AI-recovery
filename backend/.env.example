# App
SECRET_KEY=dev-only-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/speech_rehab_agent
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Local storage
STORAGE_ROOT=../storage

# Speech evaluation
SPEECH_EVAL_PROVIDER=mock

# ASR
ASR_PROVIDER=mock
ASR_API_KEY=
ASR_BASE_URL=
ASR_TIMEOUT_SECONDS=10

# Tencent ASR: set ASR_PROVIDER=tencent after supplying both credentials.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_ASR_APP_ID=
TENCENT_ASR_REGION=ap-guangzhou
TENCENT_ASR_ENGINE_MODEL_TYPE=16k_zh
TENCENT_ASR_VOICE_FORMAT=ogg-opus

# Acoustic analysis
ACOUSTIC_PROVIDER=mock
ACOUSTIC_API_KEY=
ACOUSTIC_BASE_URL=
FFMPEG_BIN=
ACOUSTIC_DBA_CALIBRATION_OFFSET=90
ACOUSTIC_VOICE_THRESHOLD_DBFS=-45
ACOUSTIC_MIN_SPEAKING_SECONDS=1.0
ACOUSTIC_MIN_LOUDNESS_DBA=45
ACOUSTIC_MIN_SNR_DB=10
ACOUSTIC_MAX_CLIPPING_RATIO=0.01

# Fine-grained pronunciation assessment via Tencent SOE New Age (new version).
PRONUNCIATION_PROVIDER=disabled
TENCENT_SOE_APP_ID=
TENCENT_SOE_ENGINE_TYPE=16k_zh
TENCENT_SOE_SCORE_COEFF=1.0
PRONUNCIATION_TIMEOUT_SECONDS=30
PRONUNCIATION_SHADOW_MODE=true

# TTS
TTS_PROVIDER=mock
TTS_API_KEY=
TTS_BASE_URL=
TTS_MODEL=
# Tencent TTS: set TTS_PROVIDER=tencent and reuse TENCENTCLOUD_SECRET_ID/SECRET_KEY above.
TENCENT_TTS_REGION=ap-guangzhou
TENCENT_TTS_VOICE_TYPE=502001
TENCENT_TTS_SAMPLE_RATE=24000
TENCENT_TTS_SPEED=-1
# Offline Windows TTS: set TTS_PROVIDER=windows. It uses an installed local SAPI voice.
WINDOWS_TTS_VOICE=Microsoft Huihui Desktop
WINDOWS_TTS_SPEED=-1
TTS_TIMEOUT_SECONDS=10

# Tencent Voice Cloning (VCL): set VCL_PROVIDER=tencent after activating VCL.
# It reuses TENCENTCLOUD_SECRET_ID/SECRET_KEY above.
VCL_PROVIDER=mock
TENCENT_VCL_REGION=ap-guangzhou
VCL_TIMEOUT_SECONDS=20

# Async avatar video (SadTalker). Keep mock until the separate GPU runtime passes manual validation.
AVATAR_VIDEO_PROVIDER=mock
SADTALKER_HOME=
SADTALKER_PYTHON=
SADTALKER_TIMEOUT_SECONDS=180
SADTALKER_PREPROCESS=crop
SADTALKER_FACE_SIZE=512
SADTALKER_USE_ENHANCER=false
AVATAR_VIDEO_FRONTEND_FALLBACK_SECONDS=60
AVATAR_VIDEO_WORKER_POLL_SECONDS=1

# LLM feedback
LLM_FEEDBACK_PROVIDER=mock
LLM_FEEDBACK_API_KEY=
LLM_FEEDBACK_BASE_URL=
LLM_FEEDBACK_MODEL=
