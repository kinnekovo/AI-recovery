# The frontend uses Vite dev-server proxy by default.
# API requests are sent to /api and proxied to this target (8001 by default).
VITE_API_PROXY_TARGET=http://localhost:8001

# Tencent Cloud Digital Human H5 SDK file supplied by Tencent.
# Leave blank to keep the local 2.5D fallback until the cloud trial is ready.
VITE_TENCENT_IVH_SDK_URL=

# Product Reset v1 is the default. Set exactly "false" to use the frozen legacy shell.
VITE_PRODUCT_V2_ENABLED=true
